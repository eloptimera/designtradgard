---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site.config";

const c = site.company;
const p = site.quotePage;
const chip =
  "flex min-h-11 cursor-pointer items-center rounded-full border-2 border-line px-5 py-2 text-sm font-bold transition-colors duration-200 hover:border-brand has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:text-white has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand-light";
---

<Base title={site.seo.quote.title} description={site.seo.quote.description}>
  <PageHero eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  <section class="container-page py-16 sm:py-24">
    <div class="reveal">
      <form
        data-form="offert"
        class="grid max-w-3xl gap-6 rounded-[2rem] border-2 border-line bg-white p-8 sm:p-10"
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="namn" class="text-sm font-bold">
              Namn
            </label>
            <input id="namn" name="namn" autocomplete="name" required class="field mt-2" />
          </div>
          <div>
            <label for="telefon" class="text-sm font-bold">
              Telefon
            </label>
            <input id="telefon" name="telefon" type="tel" autocomplete="tel" required class="field mt-2" />
          </div>
          <div>
            <label for="epost" class="text-sm font-bold">
              E-post
            </label>
            <input id="epost" name="epost" type="email" autocomplete="email" required class="field mt-2" />
          </div>
          <div>
            <label for="adress" class="text-sm font-bold">
              Adress och ort
            </label>
            <input id="adress" name="adress" autocomplete="street-address" required class="field mt-2" />
          </div>
        </div>

        <fieldset>
          <legend class="text-sm font-bold">Typ av uppdrag</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {p.types.map((t) => (
              <label class={chip}>
                <input type="checkbox" name="uppdragstyper" value={t} class="sr-only" />
                {t}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="yta_kvm" class="text-sm font-bold">
              Ungefärlig yta (kvm)
            </label>
            <input id="yta_kvm" name="yta_kvm" type="number" min="0" inputmode="numeric" class="field mt-2" />
          </div>
          <div>
            <label for="onskat_startdatum" class="text-sm font-bold">
              Önskat startdatum
            </label>
            <input id="onskat_startdatum" name="onskat_startdatum" type="date" class="field mt-2" />
          </div>
        </div>

        <div>
          <label for="meddelande" class="text-sm font-bold">
            Beskriv uppdraget
          </label>
          <textarea
            id="meddelande"
            name="meddelande"
            rows="5"
            class="field mt-2"
            placeholder={p.placeholder}
          ></textarea>
        </div>

        <label class="flex items-start gap-3 text-sm text-muted-foreground">
          <input
            type="checkbox"
            name="gdpr_samtycke"
            value="ja"
            required
            class="mt-0.5 size-5 shrink-0 accent-brand"
          />
          <span>
            Jag samtycker till att {c.name} lagrar mina uppgifter för att kunna besvara min förfrågan. Läs mer
            i
            <a href="/integritetspolicy" class="font-bold text-brand underline">
              {" "}
              integritetspolicyn
            </a>
            .
          </span>
        </label>

        <!-- Honeypot: dolt för människor, bottar fyller i det -->
        <div class="sr-only" aria-hidden="true">
          <label for="o-website">Lämna tomt</label>
          <input id="o-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p data-form-status role="alert" hidden class="text-sm font-bold text-destructive"></p>
        <div>
          <button type="submit" data-submit class="btn-base btn-dark">
            Skicka förfrågan
          </button>
        </div>
      </form>

      <div
        data-form-success="offert"
        hidden
        tabindex="-1"
        role="status"
        class="max-w-xl rounded-[2rem] border-2 border-line bg-white p-10"
      >
        <p class="eyebrow">Tack!</p>
        <h2 class="mt-5 text-3xl">{p.thanksTitle}</h2>
        <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
          {p.thanksText}
          {c.phone && ` Är det brådskande går det bra att ringa ${c.phone}.`}
        </p>
        <a href="/" class="btn-base btn-outline mt-8">
          Tillbaka till startsidan
        </a>
      </div>
    </div>
  </section>
</Base>
