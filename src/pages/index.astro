---
import Base from "../layouts/Base.astro";
import Blob from "../components/Blob.astro";
import Lines from "../components/Lines.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { mark } from "../lib/text";

const c = site.company;
const h = site.home;
const cardStyles = ["bg-brand text-white", "border-2 border-line bg-white text-ink", "bg-ink text-white"];
---

<Base title={site.seo.home.title} description={site.seo.home.description}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="mx-auto flex max-w-[88rem] flex-col px-6 pt-6 pb-14 sm:px-10 lg:min-h-[min(46rem,calc(100svh-4.5rem))] lg:pb-12">
      <div class="caps flex items-start justify-between gap-6 text-ink max-sm:justify-end">
        <span aria-hidden="true" class="hidden sm:inline">
          {h.topLeft}
        </span>
        <span>
          {c.city} · sedan {c.founded}
        </span>
      </div>

      <!-- Ordbild över blob och linjer -->
      <div class="relative my-10 flex flex-1 items-center justify-center lg:my-4">
        <Blob class="absolute top-1/2 left-1/2 -z-10 w-[min(72vw,44rem)] -translate-x-[48%] -translate-y-[56%]" />
        <Lines class="absolute inset-x-[-1.5rem] top-1/2 -z-10 h-[min(34vw,26rem)] min-h-40 w-[calc(100%+3rem)] -translate-y-1/2 text-ink/80 sm:inset-x-[-2.5rem] sm:w-[calc(100%+5rem)]" />
        <p
          aria-hidden="true"
          class="font-display text-[min(24vw,20rem)] leading-[0.9] font-medium tracking-[-0.02em] text-ink uppercase select-none"
        >
          {c.shortName}
        </p>
      </div>

      <div class="grid items-end gap-8 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
        <h1
          class="max-w-2xl text-[clamp(1.75rem,3.2vw,2.75rem)] leading-[1.12]"
          set:html={mark(h.headline)}
        />
        <div>
          <p class="max-w-md leading-relaxed text-ink/80">{h.text}</p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href={site.navCta.href} class="btn-base btn-dark">
              {h.cta}
            </a>
            {c.phone ? (
              <a href={`tel:${c.phoneLink}`} class="btn-base btn-outline">
                <Icon name="phone" class="size-4" />
                {c.phone}
              </a>
            ) : (
              <a href="/kontakt" class="btn-base btn-outline">
                {h.ctaSecondaryFallback}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tjänster -->
  <section id="tjanster" class="container-page py-20 sm:py-28">
    <div class="reveal">
      <p class="eyebrow">{h.servicesEyebrow}</p>
      <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl" set:html={mark(h.servicesHeading)} />
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {site.services.map((t, i) => (
        <div class="reveal" style={`--d:${i * 70}ms`}>
          <a
            href={`/tjanster#${t.id}`}
            class:list={[
              "group flex h-full min-h-[18rem] flex-col justify-between rounded-[2rem] p-7 transition-transform duration-300 hover:-translate-y-1 sm:p-8",
              cardStyles[i % cardStyles.length],
            ]}
          >
            <div class="flex items-start justify-between">
              <span class="grid size-14 place-items-center rounded-full bg-white/20 ring-1 ring-current/15">
                <Icon name={t.icon} class="size-6" />
              </span>
              <span class="grid size-11 place-items-center rounded-full bg-white text-brand transition-colors group-hover:bg-sun group-hover:text-ink">
                <Icon name="arrowUpRight" />
              </span>
            </div>
            <div class="mt-10">
              <h3 class="text-3xl">{t.title}</h3>
              <p class="mt-3 leading-relaxed opacity-90">{t.short}</p>
            </div>
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Varför -->
  <section class="bg-fade-tint py-20 sm:py-28">
    <div class="container-page">
      <div class="reveal">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl" set:html={mark(h.whyHeading)} />
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {h.why.map((f, i) => (
          <div class="reveal" style={`--d:${i * 80}ms`}>
            <article class="h-full rounded-[2rem] bg-white p-8 shadow-sm shadow-brand/10">
              <span class="grid size-14 place-items-center rounded-full bg-brand text-white">
                <Icon name={f.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-2xl">{f.title}</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{f.text}</p>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Om oss -->
  <section class="container-page grid gap-12 py-20 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-16">
    <div class="reveal">
      <p class="eyebrow">{h.aboutEyebrow}</p>
      <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl" set:html={mark(h.aboutHeading)} />
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">{h.aboutText}</p>
      <a href="/om-oss" class="btn-base btn-outline mt-8">
        {h.aboutLink}
      </a>
    </div>
    <div class="reveal" style="--d:120ms">
      <dl class="grid grid-cols-2 gap-4">
        <div class="rounded-[2rem] bg-brand p-6 text-white">
          <dt class="text-xs font-bold tracking-[0.14em] text-white/85 uppercase">Verksamma sedan</dt>
          <dd class="mt-3 font-display text-4xl sm:text-5xl">{c.founded}</dd>
        </div>
        <div class="rounded-[2rem] bg-ink p-6 text-white">
          <dt class="text-xs font-bold tracking-[0.14em] text-sun uppercase">Säte</dt>
          <dd class="mt-3 font-display text-2xl sm:text-4xl">{c.city}</dd>
        </div>
        <div class="col-span-2 rounded-[2rem] bg-tint p-6">
          <dt class="text-xs font-bold tracking-[0.14em] text-brand uppercase">Anställda</dt>
          <dd class="mt-3 font-display text-3xl text-ink">{c.employees}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Avslutande CTA -->
  <section class="px-3 pb-3 sm:px-6">
    <div class="reveal">
      <div class="panel-ink relative isolate mx-auto max-w-[88rem] overflow-hidden rounded-[2rem] px-6 py-16 sm:px-14 sm:py-24">
        <Blob class="absolute top-1/2 -right-24 -z-10 hidden w-[34rem] -translate-y-1/2 lg:block" />
        <p class="caps text-white/70">{h.ctaEyebrow}</p>
        <h2
          class="mt-5 max-w-2xl text-[clamp(2.2rem,5vw,4.25rem)] leading-[1.05]"
          set:html={mark(h.ctaHeading)}
        />
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.navCta.href} class="btn-base btn-white">
            {site.navCta.label}
          </a>
          <a href="/kontakt" class="btn-base btn-outline-white">
            Kontakta oss
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
