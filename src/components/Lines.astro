---
/** Tunna linjer: en ellips och två horisontella – korsar blobben och ordbilden. */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 1000 400"
  preserveAspectRatio="none"
  class:list={["pointer-events-none", className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
>
  <line x1="0" y1="62" x2="1000" y2="62" vector-effect="non-scaling-stroke"></line>
  <line x1="0" y1="338" x2="1000" y2="338" vector-effect="non-scaling-stroke"></line>
  <ellipse cx="650" cy="200" rx="290" ry="196" vector-effect="non-scaling-stroke"></ellipse>
</svg>
